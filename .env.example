# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for the backend.
# Example: mongodb+srv://user:pass@cluster0.mongodb.net/ibbani-cafe?retryWrites=true&w=majority
MONGODB_URI="YOUR_MONGODB_URI"

# If your local environment cannot resolve SRV records, provide a standard non-SRV URI.
# Example:
# MONGODB_FALLBACK_URI="mongodb://user:pass@cluster0-shard-00-00.bvgkk6e.mongodb.net:27017,cluster0-shard-00-01.bvgkk6e.mongodb.net:27017,cluster0-shard-00-02.bvgkk6e.mongodb.net:27017/ibbani-cafe?ssl=true&replicaSet=atlas-<replicaSetName>-shard-0&authSource=admin&retryWrites=true&w=majority"
MONGODB_FALLBACK_URI=""

# Optional database name to use for collections.
MONGODB_DB="ibbani-cafe"

# EmailJS configuration for booking confirmation emails.
VITE_EMAILJS_SERVICE_ID="YOUR_EMAILJS_SERVICE_ID"
VITE_EMAILJS_TEMPLATE_ID="YOUR_EMAILJS_TEMPLATE_ID"
VITE_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"

# Admin authentication credentials (backend).
# Change these to secure values in production!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Cafe2026Admin123"

# JWT secret key for token signing (backend).
# Generate a random string and change this in production!
JWT_SECRET="your_super_secret_jwt_key_change_in_production"
